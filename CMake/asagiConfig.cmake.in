@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if (NOT TARGET asagi::asagi)
    set(ASAGI_shared_targets "${CMAKE_CURRENT_LIST_DIR}/asagiSharedTargets.cmake")
    set(ASAGI_static_targets "${CMAKE_CURRENT_LIST_DIR}/asagiStaticTargets.cmake")
    if (static IN_LIST ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
        include (${ASAGI_static_targets})
        add_library(asagi::asagi ALIAS asagi::asagi-static)
    elseif (shared IN_LIST ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
        include (${ASAGI_shared_targets})
        add_library(asagi::asagi ALIAS asagi::asagi-shared)
    else()
        if ((BUILD_SHARED_LIBS AND (EXISTS ${ASAGI_shared_targets})) OR (NOT BUILD_SHARED_LIBS AND NOT (EXISTS ${ASAGI_static_targets})))
            include (${ASAGI_shared_targets})
            add_library(asagi::asagi ALIAS asagi::asagi-shared)
        else()
            include (${ASAGI_static_targets})
            add_library(asagi::asagi ALIAS asagi::asagi-static)
        endif()
    endif()
endif()
